---
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/global.css';
import ConsentBanner from '../components/ConsentBanner.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SeoHead from '../components/SeoHead.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import LanguageBanner from '../components/LanguageBanner.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { loadContent } from '../lib/content/load';
import { htmlLang, type Locale } from '../lib/i18n/locales';
import type { PageRef } from '../lib/routes';
import type { MessageContext } from '../lib/whatsapp';

interface Props {
  locale: Locale;
  page: PageRef;
  title: string;
  /** Meta description (70 to 155 characters). */
  description: string;
  /** Source of the OG image (see SeoHead). */
  image?: ImageMetadata;
  /** JSON-LD objects for this page. */
  jsonLd?: object[];
  /** The fixed WhatsApp button of this page: a property page passes its context and number. */
  whatsapp?: { context: MessageContext; phone?: string };
}

const { locale, page, title, description, image, jsonLd, whatsapp } = Astro.props;
const { site } = await loadContent();
const whatsappPhone = whatsapp?.phone ?? site.contact.whatsapp;
---

<html lang={htmlLang(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <SeoHead
      locale={locale}
      page={page}
      title={title}
      description={description}
      image={image}
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <LanguageBanner locale={locale} page={page} />
    <Header locale={locale}>
      <LanguageSwitcher slot="language-switcher" locale={locale} page={page} />
    </Header>
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
    <WhatsAppFab locale={locale} phone={whatsappPhone} context={whatsapp?.context} />
    <ConsentBanner locale={locale} />
  </body>
</html>
