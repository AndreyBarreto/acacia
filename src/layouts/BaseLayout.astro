---
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/global.css';
import ConsentBanner from '../components/ConsentBanner.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SeoHead from '../components/SeoHead.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import { htmlLang, type Locale } from '../lib/i18n/locales';

interface Props {
  locale: Locale;
  title: string;
}

const { locale, title } = Astro.props;
---

<html lang={htmlLang(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <SeoHead locale={locale} title={title} />
  </head>
  <body>
    <Header locale={locale} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
    <WhatsAppFab locale={locale} />
    <ConsentBanner locale={locale} />
  </body>
</html>
