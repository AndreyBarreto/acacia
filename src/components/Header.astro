---
import logo from '../../assets/brand/logo/logo-horizontal-light.svg';
import type { Locale } from '../lib/i18n/locales';
import { routePath } from '../lib/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const logoHeight = 40;
const logoWidth = Math.round((logo.width / logo.height) * logoHeight);

// "Jurerê" is the same label in pt, en and es (CLAUDE.md, T19), so it needs no translation.
const homeHref = routePath({ id: 'home' }, locale);
const neighborhoodHref = routePath({ id: 'neighborhood' }, locale);
---

<header class="site-header">
  <a class="brand" href={homeHref}>
    <img src={logo.src} alt="Acácia" width={logoWidth} height={logoHeight} />
  </a>
  <nav class="nav">
    <a class="nav-link" href={neighborhoodHref}>
      Jurerê
    </a>
    <slot name="language-switcher" />
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-3);
    padding-inline: max(var(--gutter), var(--safe-left), (100% - var(--container-max)) / 2)
      max(var(--gutter), var(--safe-right), (100% - var(--container-max)) / 2);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap-min);
  }

  .brand img {
    inline-size: auto;
    block-size: 2.5rem;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap-min);
    padding-inline: var(--space-3);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-ui);
    text-decoration: none;
  }

  .nav-link:hover {
    text-decoration: underline;
  }
</style>
